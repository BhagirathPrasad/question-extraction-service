# ─────────────────────────────────────────────────────────────────────────────
# Question Extraction Service — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=qes_user
POSTGRES_PASSWORD=qes_password
POSTGRES_DB=question_extraction

# Async URL used by FastAPI app
DATABASE_URL=postgresql+asyncpg://qes_user:qes_password@db:5432/question_extraction

# Sync URL used by Alembic migrations (psycopg2)
DATABASE_URL_SYNC=postgresql://qes_user:qes_password@db:5432/question_extraction

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Authentication / JWT ─────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50

# ─── Google Gemini API (Vision + Text) ───────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# If not set, the service falls back to Tesseract-only OCR extraction.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
